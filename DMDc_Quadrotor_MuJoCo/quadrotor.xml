<mujoco model="dmdc_quadrotor">

    <compiler angle="radian" autolimits="true"/>

    <option
        timestep="0.002"
        integrator="RK4"
        gravity="0 0 -9.81"/>

    <visual>
        <headlight
            diffuse="0.8 0.8 0.8"
            ambient="0.3 0.3 0.3"/>

        <map
            znear="0.01"
            zfar="100"/>
    </visual>

    <default>

        <geom
            contype="1"
            conaffinity="1"
            friction="0.8 0.1 0.1"/>

        <site
            size="0.025"/>

    </default>


    <worldbody>

        <!-- Ground -->
        <geom
            name="floor"
            type="plane"
            pos="0 0 0"
            size="10 10 0.1"
            rgba="0.18 0.18 0.18 1"/>


        <!-- Lighting -->
        <light
            name="sun"
            pos="0 0 5"
            dir="0 0 -1"
            directional="true"/>


        <!-- QUADROTOR -->
        <body
            name="quadrotor"
            pos="0 0 1.0">

            <!-- Six-DOF floating body -->
            <freejoint name="free"/>


            <!-- Physical properties -->
            <inertial
                pos="0 0 0"
                mass="1.0"
                diaginertia="0.02 0.02 0.04"/>


            <!-- Central frame -->
            <geom
                name="body"
                type="box"
                size="0.14 0.10 0.04"
                mass="0"
                rgba="0.15 0.25 0.8 1"/>


            <!-- Cross arms -->
            <geom
                name="arm_x"
                type="capsule"
                fromto="-0.45 0 0 0.45 0 0"
                size="0.018"
                mass="0"
                rgba="0.15 0.15 0.15 1"/>

            <geom
                name="arm_y"
                type="capsule"
                fromto="0 -0.45 0 0 0.45 0"
                size="0.018"
                mass="0"
                rgba="0.15 0.15 0.15 1"/>


            <!-- MOTOR SITES -->

            <!-- Motor 1: +X -->
            <site
                name="motor1_site"
                pos="0.45 0 0"
                type="cylinder"
                size="0.04 0.008"
                rgba="0.9 0.2 0.2 1"/>


            <!-- Motor 2: -Y -->
            <site
                name="motor2_site"
                pos="0 -0.45 0"
                type="cylinder"
                size="0.04 0.008"
                rgba="0.2 0.9 0.2 1"/>


            <!-- Motor 3: -X -->
            <site
                name="motor3_site"
                pos="-0.45 0 0"
                type="cylinder"
                size="0.04 0.008"
                rgba="0.2 0.4 0.9 1"/>


            <!-- Motor 4: +Y -->
            <site
                name="motor4_site"
                pos="0 0.45 0"
                type="cylinder"
                size="0.04 0.008"
                rgba="0.9 0.7 0.1 1"/>


            <!-- Propeller visualizations -->

            <geom
                name="prop1"
                type="cylinder"
                pos="0.45 0 0.035"
                size="0.13 0.006"
                mass="0"
                contype="0"
                conaffinity="0"
                rgba="0.8 0.8 0.8 0.25"/>

            <geom
                name="prop2"
                type="cylinder"
                pos="0 -0.45 0.035"
                size="0.13 0.006"
                mass="0"
                contype="0"
                conaffinity="0"
                rgba="0.8 0.8 0.8 0.25"/>

            <geom
                name="prop3"
                type="cylinder"
                pos="-0.45 0 0.035"
                size="0.13 0.006"
                mass="0"
                contype="0"
                conaffinity="0"
                rgba="0.8 0.8 0.8 0.25"/>

            <geom
                name="prop4"
                type="cylinder"
                pos="0 0.45 0.035"
                size="0.13 0.006"
                mass="0"
                contype="0"
                conaffinity="0"
                rgba="0.8 0.8 0.8 0.25"/>

        </body>

    </worldbody>


    <!-- FOUR VIRTUAL MOTORS -->

    <actuator>

        <!-- Motor 1 -->
        <motor
            name="motor1"
            site="motor1_site"
            gear="0 0 1 0 0 0.02"
            ctrllimited="true"
            ctrlrange="0 8"/>


        <!-- Motor 2 -->
        <motor
            name="motor2"
            site="motor2_site"
            gear="0 0 1 0 0 -0.02"
            ctrllimited="true"
            ctrlrange="0 8"/>


        <!-- Motor 3 -->
        <motor
            name="motor3"
            site="motor3_site"
            gear="0 0 1 0 0 0.02"
            ctrllimited="true"
            ctrlrange="0 8"/>


        <!-- Motor 4 -->
        <motor
            name="motor4"
            site="motor4_site"
            gear="0 0 1 0 0 -0.02"
            ctrllimited="true"
            ctrlrange="0 8"/>

    </actuator>

</mujoco>