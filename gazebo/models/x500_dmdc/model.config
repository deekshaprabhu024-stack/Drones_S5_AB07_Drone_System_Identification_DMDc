<?xml version="1.0"?>
<model>
  <name>x500_dmdc</name>
  <version>1.0</version>
  <sdf version="1.9">model.sdf</sdf>
  <author>
    <name>Drone System Identification Team</name>
  </author>
  <description>
    Simple X-configuration quadrotor used for DMDc system identification
    in Gazebo (gz-sim). Four independently commandable rotors driven by
    the built-in MulticopterMotorModel plugin, with full-state odometry
    published for data collection.
  </description>
</model>
