<?xml version="1.0"?>
<?xml-model href="http://download.ros.org/schema/package_format3.xsd" schematypens="http://www.w3.org/2001/XMLSchema"?>
<package format="3">
  <name>quad_dmdc_sim</name>
  <version>0.1.0</version>
  <description>
    Drone system identification using DMDc, re-implemented on top of
    Gazebo (gz-sim) instead of Gym-PyBullet. Same DMDc/SVD pipeline as
    the original project; only the data-generation front end changes.
  </description>
  <maintainer email="you@example.com">Your Name</maintainer>
  <license>MIT</license>

  <exec_depend>ros_gz_sim</exec_depend>
  <exec_depend>ros_gz_bridge</exec_depend>
  <exec_depend>rclpy</exec_depend>
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>actuator_msgs</exec_depend>
  <exec_depend>rosgraph_msgs</exec_depend>

  <export>
    <build_type>ament_python</build_type>
  </export>
</package>
